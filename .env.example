# ==============================================================================
# پیکربندی متغیرهای محیطی لندینگ‌پیج شخصی و هاب ارتباطی (Showcase Hub)
# Personal Landing Hub & Tech Showcase Environment Configuration
# ==============================================================================
# این فایل را به عنوان .env.local در ریشه پروژه کپی کنید:
# Copy this file to .env.local in the root directory:
#   cp .env.example .env.local
#
# توجه: تمام متغیرها اختیاری هستند و در صورت خالی بودن از مقادیر پیش‌فرض استفاده می‌شود.
# Note: All variables are optional; defaults are used if not specified.
# ==============================================================================

# ------------------------------------------------------------------------------
# ۱. مشخصات فردی و عناوین اصلی / Personal Identity & Main Titles
# ------------------------------------------------------------------------------
# نام کامل یا برند شخصی
NEXT_PUBLIC_SITE_NAME="نام شما"

# عنوان شغلی و زمینه فعالیت
NEXT_PUBLIC_SITE_TITLE="توسعه‌دهنده نرم‌افزار و مهندس وب"

# شعار اصلی بالای صفحه (Headline)
NEXT_PUBLIC_SITE_HEADLINE="خلق تجربیات مدرن وب و معماری سیستم‌های نرم‌افزاری"

# بیوگرافی کوتاه (نمایش در بخش بالایی و متادیتای سئو)
NEXT_PUBLIC_SITE_BIO="توسعه‌دهنده فول‌استک و علاقه‌مند به متن‌باز، معماری نرم‌افزار و انتقال تجربیات فنی مهندسی وب."

# آدرس دامنه وب‌سایت برای تولید لینک‌های کانونیکال و تگ‌های OpenGraph
NEXT_PUBLIC_SITE_URL="https://example.com"

# ------------------------------------------------------------------------------
# ۲. تصویر پروفایل / Avatar
# ------------------------------------------------------------------------------

# مسیر یا لینک عکس پرتره / آواتار (می‌تواند فایل محلی در public یا لینک اینترنتی باشد)
NEXT_PUBLIC_AVATAR_SRC="/avatar.svg"

# متن جایگزین تصویر آواتار برای دسترس‌پذیری
NEXT_PUBLIC_AVATAR_ALT="تصویر پروفایل کاربر"

# حروف اختصاری فال‌بک آواتار در صورت لود نشدن تصویر
NEXT_PUBLIC_AVATAR_FALLBACK="ن‌ش"

# تصویر پیش‌نمایش در شبکه‌های اجتماعی (OpenGraph & Twitter Card Image)
NEXT_PUBLIC_OG_IMAGE="/og-image.svg"

# ------------------------------------------------------------------------------
# ۳. دکمه‌های فراخوان عمل اصلی و فرعی / Call to Actions (CTA)
# ------------------------------------------------------------------------------
# دکمه فراخوان اصلی (Primary CTA)
NEXT_PUBLIC_PRIMARY_CTA_LABEL="کانال یوتیوب"
NEXT_PUBLIC_PRIMARY_CTA_URL="https://youtube.com/@example"
NEXT_PUBLIC_PRIMARY_CTA_ICON="youtube"
NEXT_PUBLIC_PRIMARY_CTA_DESC="آموزش‌های ویدیویی تخصصی، کدنویسی زنده و تحلیل معماری"

# دکمه فراخوان فرعی (Secondary CTA)
NEXT_PUBLIC_SECONDARY_CTA_LABEL="عضویت در کانال تلگرام"
NEXT_PUBLIC_SECONDARY_CTA_URL="https://t.me/example"
NEXT_PUBLIC_SECONDARY_CTA_ICON="send"
NEXT_PUBLIC_SECONDARY_CTA_DESC="اطلاعیه‌ها، نکات روزانه، پرسش‌وپاسخ و کامیونیتی برنامه‌نویسان"

# ------------------------------------------------------------------------------
# ۴. شبکه‌های اجتماعی و کانال‌های تخصصی / Social & Community Channels
# ------------------------------------------------------------------------------
# یوتیوب / YouTube
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/@example"
NEXT_PUBLIC_YOUTUBE_HANDLE="@example"
NEXT_PUBLIC_YOUTUBE_LABEL="یوتیوب (YouTube)"
NEXT_PUBLIC_YOUTUBE_STAT="ویدیوهای تخصصی"
NEXT_PUBLIC_YOUTUBE_DESC="ویدیوهای پروژه‌محور فرانت‌اند و بک‌اند، تحلیل معماری و لایو استریم‌ها"

# تلگرام / Telegram
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/example"
NEXT_PUBLIC_TELEGRAM_HANDLE="@example"
NEXT_PUBLIC_TELEGRAM_LABEL="تلگرام (Telegram)"
NEXT_PUBLIC_TELEGRAM_STAT="کامیونیتی برنامه‌نویسان"
NEXT_PUBLIC_TELEGRAM_DESC="اشتراک‌گذاری منابع کاربردی، کدهای نمونه و اطلاعیه‌های جدید"

# لینکدین / LinkedIn
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/in/username"
NEXT_PUBLIC_LINKEDIN_HANDLE="in/username"
NEXT_PUBLIC_LINKEDIN_LABEL="لینکدین (LinkedIn)"
NEXT_PUBLIC_LINKEDIN_STAT="ارتباطات حرفه‌ای"
NEXT_PUBLIC_LINKEDIN_DESC="شبکه‌سازی تخصصی، دستاوردهای شغلی و تجربیات مهندسی نرم‌افزار"

# گیت‌هاب / GitHub
NEXT_PUBLIC_GITHUB_URL="https://github.com/username"
NEXT_PUBLIC_GITHUB_HANDLE="username"
NEXT_PUBLIC_GITHUB_LABEL="گیت‌هاب (GitHub)"
NEXT_PUBLIC_GITHUB_STAT="کدهای متن‌باز"
NEXT_PUBLIC_GITHUB_DESC="مخازن پروژه‌های آموزشی، کتابخانه‌ها و سورس‌کدهای عمومی"

# ------------------------------------------------------------------------------
# ۵. ویدیوهای آموزشی برگزیده / Featured Highlight Videos
# ------------------------------------------------------------------------------
# توجه: ویدیوهای برگزیده مستقیماً از فایل data/featured-videos.json خوانده می‌شوند
# و توسط جاب اتوماتیک گیت‌هاب (با استفاده از سکرت YOUTUBE_API_KEY) همگام‌سازی می‌گردند.
# در صورت خالی بودن فایل دیتای مربوطه، بخش ویدیوها در صفحه مخفی خواهد شد.

# ------------------------------------------------------------------------------
# ۶. بخش درباره من / About Section
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ABOUT_HEADING="درباره من"
NEXT_PUBLIC_ABOUT_PARAGRAPHS_JSON='["بیش از چند سال است که در زمینه مهندسی نرم‌افزار، توسعه وب و طراحی سیستم‌های مدرن فعالیت می‌کنم.","هدف از راه‌اندازی این هاب، ایجاد پلی ارتباطی میان توسعه‌دهندگان، اشتراک‌گذاری تجربیات واقعی پروژه‌ها و گسترش دانش مهندسی نرم‌افزار است."]'
NEXT_PUBLIC_ABOUT_FOCUS_AREAS_JSON='["سیستم دیزاین","توسعه وب","معماری نرم‌افزار","متن‌باز"]'

# ------------------------------------------------------------------------------
# ۷. فوتر و ایمیل تماس / Footer & Contact Email
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FOOTER_COPYRIGHT="تمامی حقوق محفوظ است."
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"
